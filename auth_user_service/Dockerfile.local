# ---------- DEV BUILD STAGE ----------
# Dev-only image for local tests against the sibling auth-sdk-m8 checkout.
# Build from the fa-auth-m8 repo root and pass the sibling SDK as a named context:
#   docker build -f auth_user_service/Dockerfile.local \
#     --build-context auth-sdk-m8=../auth-sdk-m8 .
FROM python:3.14-slim@sha256:c845af9399020c7e562969a13689e929074a10fd057acd1b1fad06a2fb068e97 AS builder

WORKDIR /install

ENV PIP_ROOT_USER_ACTION=ignore

COPY auth_user_service/requirements_base.txt .
COPY auth_user_service/requirements_dev.txt .
COPY --from=auth-sdk-m8 . /tmp/auth-sdk-m8

RUN pip install --upgrade "pip==26.1.1" && \
    sed '/^auth-sdk-m8[<>=!~ ]/d' requirements_base.txt > requirements_base_local.txt && \
    sed '/^-r requirements_base.txt$/d' requirements_dev.txt > requirements_dev_local.txt && \
    pip install --prefix=/install --no-cache-dir -r requirements_base_local.txt && \
    pip install --prefix=/install --no-cache-dir "/tmp/auth-sdk-m8[all]" && \
    pip install --prefix=/install --no-cache-dir -r requirements_dev_local.txt


# ---------- DEV RUNTIME STAGE ----------
FROM python:3.14-slim@sha256:c845af9399020c7e562969a13689e929074a10fd057acd1b1fad06a2fb068e97

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PATH="/home/appuser/.local/bin:$PATH"
ENV PYTHONPATH=/opt/auth_user_service

RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends curl=8.14.1-2+deb13u3 \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid 1000 appuser && \
    useradd --uid 1000 --gid appuser --create-home appuser

WORKDIR /opt

COPY --from=builder /install /usr/local
COPY --chown=appuser:appuser auth_user_service ./auth_user_service

RUN find /opt/auth_user_service/scripts -name "*.sh" -exec sed -i 's/\r$//' {} + && \
    chmod +x /opt/auth_user_service/scripts/*.sh

USER appuser

EXPOSE 8000

CMD ["./auth_user_service/scripts/docker_start.sh"]
