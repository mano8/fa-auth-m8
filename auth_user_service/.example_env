# local envs — for running auth_user_service directly (no Docker / no proxy)
# Copy to auth_user_service/.env and replace every "changethis" with real values.
# Generate secret keys: python -c "import secrets; print(secrets.token_urlsafe(48))"

DOMAIN="localhost"
ENVIRONMENT="local"

API_PREFIX="/user"
# Docs are suppressed in ENVIRONMENT=production by default (auth-sdk-m8 ≥ 0.7.3).
# In development/staging these flags act as opt-in overrides.
SET_OPEN_API=true
SET_DOCS=true
SET_REDOC=true
# Explicitly enable docs in production. Only for public/open-source APIs; emits a startup warning.
#SERVE_DOCS_IN_PRODUCTION=false
PROJECT_NAME="M8App"
STACK_NAME="full-stack-m8-app"

# ── Backend & CORS ─────────────────────────────────────────────────────────────
BACKEND_HOST="http://127.0.0.1:9000"
FRONTEND_HOST="http://localhost:5173"
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5173,https://localhost,https://localhost:5173"

# ── Service role ───────────────────────────────────────────────────────────────
# issuer — this service signs tokens and serves /.well-known/jwks.json
AUTH_SERVICE_ROLE="issuer"

# ── Database (local — adjust DB_HOST for Docker) ──────────────────────────────
SELECTED_DB=Mysql
DB_HOST="127.0.0.1"
DB_PORT=3306
DB_DATABASE="m8_app"
DB_USER="changethis"
DB_PASSWORD="changethis"

# ── Redis (local — no TLS required) ───────────────────────────────────────────
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_USER="appuser"
REDIS_PASSWORD="changethis"
#REDIS_SSL=false
#REDIS_SSL_CA=   # path to CA cert — required when REDIS_SSL=true
#REDIS_SSL_CERT= # path to client cert for mTLS
#REDIS_SSL_KEY=  # path to client key for mTLS

# ── Tokens ─────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_ALGORITHM=HS256
REFRESH_TOKEN_ALGORITHM=HS256
ACCESS_SECRET_KEY="changethis"
REFRESH_SECRET_KEY="changethis"
# Previous refresh signing key — used during key rotation (optional).
#REFRESH_SECRET_KEY_OLD=
TOKEN_MODE=stateful
#TOKEN_MODE=stateless  # stateless: JWTs are self-contained; Redis not required

ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=3600

# ── Token boundary claims ─────────────────────────────────────────────────────
# auth-sdk-m8 >= 1.0.0 turns TOKEN_STRICT_VALIDATION on by default: the service
# fails closed at boot unless both TOKEN_ISSUER and TOKEN_AUDIENCE are set, and
# every validator enforces an exact iss/aud match. For local single-service dev
# (no cross-service boundary) opt out with TOKEN_STRICT_VALIDATION=false.
TOKEN_STRICT_VALIDATION=false
# To mirror production instead, set TOKEN_STRICT_VALIDATION=true and provide
# identical values here and in every consumer service:
#TOKEN_ISSUER=https://auth.example.com
#TOKEN_AUDIENCE=https://api.example.com

# ── Bootstrap superuser ────────────────────────────────────────────────────────
FIRST_SUPERUSER="changethis"
FIRST_SUPERUSER_PASSWORD="changethis"

# ── Inter-service & encryption secrets ────────────────────────────────────────
# Service-owned key that SIGNS short-TTL service tokens (HS256) and gates the
# /health detail + /metrics scrape (1.4). It is NO LONGER a private-API gate:
# the legacy single-secret X-Internal-Token path was retired in v1.0.0. Still
# required (no default).
PRIVATE_API_SECRET="changethis"

# Per-consumer private-API credentials (v1.0.0 — the only private-API auth model;
# the legacy single-PRIVATE_API_SECRET gate is retired). JSON map of consumer id →
# {secret, scopes}; each consumer presents X-Internal-Client + X-Internal-Token (or
# exchanges it for a short-TTL service token) and is authorized only for its
# granted scopes (introspection / event-stream / user-create; deny-by-default).
# `secret` may be plaintext (dev) or the hashed-at-rest `sha256$<salt>$<digest>`
# form (prod). REQUIRED for any inter-service traffic: when empty every /private/*
# call fails closed (401) and the service-token exchange is disabled (404).
#PRIVATE_API_CONSUMERS='{"media-service":{"secret":"changethis","scopes":["introspection"]}}'

# Dedicated signing key for the Starlette session cookie. Required (no default);
# kept separate from TOKENS_ENCRYPTION_KEY so rotating one does not invalidate
# the other.
SESSION_SECRET="changethis"

# Symmetric key used to encrypt Google OAuth tokens at rest.
TOKENS_ENCRYPTION_KEY="changethis"
# Set only during a TOKENS_ENCRYPTION_KEY rotation: the previous key, kept so
# tokens encrypted under it stay decryptable (MultiFernet new→old fallback).
# Remove once every stored token has been re-encrypted under / expired past the
# new key. Leave commented in steady state.
#TOKENS_ENCRYPTION_KEY_OLD="changethis"

# ── Event signing (Redis Pub/Sub) ─────────────────────────────────────────────
# Secure-by-default (auth-sdk-m8 >= 1.0.0): event-bus payloads are HMAC-signed
# and EVENT_SIGNING_ENABLED defaults to true, so the service fails closed at boot
# unless EVENT_SIGNING_KEY is set. Set EVENT_SIGNING_ENABLED=false to opt out.
EVENT_SIGNING_ENABLED=true
EVENT_SIGNING_KEY="changethis"

# ── Auth degradation policy (optional) ────────────────────────────────────────
# Controls behaviour when Redis is unavailable. Defaults shown.
# fail_open: allow through.  fail_closed: return 503.
# AUTH_STRICT_MODE=true overrides all per-control modes to fail_closed.
#AUTH_STRICT_MODE=false
#REFRESH_VALIDATION_FAILURE_MODE=fail_closed
#SESSION_WRITE_FAILURE_MODE=fail_closed
#RATE_LIMIT_FAILURE_MODE=fail_open
#ACCESS_REVOCATION_FAILURE_MODE=fail_open

# ── Proxy trust ────────────────────────────────────────────────────────────────
# Set to 0 when running without a reverse proxy (local dev without Docker/Traefik).
# Set to 1 when a single Traefik instance sits in front (Docker Compose stacks).
TRUSTED_PROXY_COUNT=0

# ── Login / refresh rate limiting (optional) ──────────────────────────────────
#LOGIN_RATE_LIMIT_REQUESTS=5
#LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
#REFRESH_RATE_LIMIT_REQUESTS=10
#REFRESH_RATE_LIMIT_WINDOW_MINUTES=5

# ── API key rate limiting (optional) ──────────────────────────────────────────
# When Redis is unavailable, strict behaviour refuses valid keys with 503 rather
# than admit them without a rate-limit ceiling. It is auto-enabled in
# production/strict (ENVIRONMENT=production, STRICT_PRODUCTION_MODE=true, or
# AUTH_STRICT_MODE=true); this flag only forces it on in other environments and
# is UNSAFE to leave off in production. Non-strict dev fails open (logged).
#API_KEY_STRICT_RATE_LIMIT=false
#API_KEY_DEFAULT_LIMIT_MINUTE=60
#API_KEY_DEFAULT_LIMIT_HOUR=1000
#API_KEY_DEFAULT_LIMIT_DAY=10000
#API_KEY_DEFAULT_LIMIT_MONTH=200000
#API_KEY_MAX_PER_USER=10
# Per-consumer anti-abuse ceiling (requests/minute) for the private API-key
# introspection endpoint (POST /private/v1/api-keys/introspect, §3.12), consumed
# on every authenticated attempt — separate from the introspected key's own quota.
#API_KEY_INTROSPECTION_ANTIABUSE_PER_MINUTE=600

# ── Observability ──────────────────────────────────────────────────────────────
METRICS_ENABLED=false
METRICS_GROUPS=all
# Optional static scoped scrape credential for {API_PREFIX}/metrics. Leave unset
# to keep metrics internal-only (the network boundary is the control). When set,
# scrapers must send `Authorization: Bearer <credential>` (constant-time match).
#METRICS_SCRAPE_CREDENTIAL=changethis
# Dedicated credential for the deep /health detail gate (9.3). When set, callers
# presenting this value via X-Internal-Token receive the full infrastructure body
# (token mode, Redis/DB); when unset the gate fails closed (no detail regardless of
# token). Must differ from PRIVATE_API_SECRET (startup rejects reuse).
# HEALTH_DETAIL_CREDENTIAL_FILE is also accepted for Docker/K8s file-mounted secrets.
#HEALTH_DETAIL_CREDENTIAL=changethis

# ── Google OAuth (optional — uncomment to enable) ─────────────────────────────
# GOOGLE_CLIENT_ID="changethis"
# GOOGLE_CLIENT_SECRET="changethis"

# ── Chrome extension / native-app OAuth (optional) ────────────────────────────
# Fixed backend callback URI — must match Google Console exactly.
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/user/google-auth/oauth-callback/

# URI schemes accepted as redirect_target at /google-api/login-url/ (default shown).
# OAUTH_ALLOWED_REDIRECT_SCHEMES=chrome-extension://

# Optional: lock to specific extension IDs (empty = open public-client model).
# OAUTH_ALLOWED_REDIRECT_PREFIXES=chrome-extension://abc123def456.../

# Scheme-level CORS — required for Chrome extension fetch() calls.
# CORS_ALLOWED_ORIGIN_SCHEMES=chrome-extension://
