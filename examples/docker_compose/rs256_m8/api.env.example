# Copy to api.env and replace every "changethis" with real values.
# Does NOT include auth-service-only secrets (FIRST_SUPERUSER, PRIVATE_API_SECRET,
# TOKENS_ENCRYPTION_KEY, ACCESS_PRIVATE_KEY_FILE, ACCESS_KEY_ID).
# Consumer verifies access tokens via JWKS — no private key or ACCESS_SECRET_KEY needed.

# ── Identity ──────────────────────────────────────────────────────────────────
# Hostname this stack is served on (localhost, an IPv4 or a domain).
DOMAIN=localhost
# local | development | staging | production - selects the SDK's security
# posture.
ENVIRONMENT=local
# Project identifier shown in API docs and logs (letters, digits, _ and -).
PROJECT_NAME=M8FastApi
# Stack slug used in names and logs (lowercase letters, digits and -).
STACK_NAME=m8-fastapi-service

# ── API & docs ────────────────────────────────────────────────────────────────
# Route prefix the service is mounted under behind Traefik (path chars only,
# e.g. /user).
API_PREFIX=/fastapi
# Serve the OpenAPI schema (true | false).
SET_OPEN_API=true
# Serve Swagger UI (true | false).
SET_DOCS=true
# Serve ReDoc (true | false).
SET_REDOC=true

# ── CORS / Frontend ───────────────────────────────────────────────────────────
# Public base URL of this backend (scheme://host[:port]).
BACKEND_HOST=http://127.0.0.1:9000
# Public URL of the frontend (scheme://host[:port]); used in links the backend
# emits.
FRONTEND_HOST=http://localhost:5173
# Comma-separated browser origins allowed by CORS, each scheme://host[:port]
# with no path.
BACKEND_CORS_ORIGINS=http://localhost,http://localhost:5173,http://localhost:9000,https://localhost,https://localhost:9000,https://localhost:5173

# ── Service role & auth routing ───────────────────────────────────────────────
# issuer (mints tokens, holds keys) or consumer (only validates tokens; must
# not hold private keys).
AUTH_SERVICE_ROLE=consumer
# Sub-prefix of the auth routes a fastapi-m8 consumer mounts (default /auth).
AUTH_PREFIX=/user

# ── Database (MySQL) ──────────────────────────────────────────────────────────
# Database dialect: Postgres | Mysql | Mariadb.
SELECTED_DB=Mysql
# Database hostname (compose service name, or a managed DB host).
DB_HOST=m8_db
# Database port (1-65535; 5432 for PostgreSQL).
DB_PORT=3306
# Database name the service connects to (letters, digits, _ and -).
DB_DATABASE=api_db
# Database role the service logs in as (created by init-db.sh).
# Value: PostgreSQL role name - letters, digits and _, starting with a letter;
#   max 63 chars.
DB_USER=changethis_api_user
# Password of DB_USER.
# Value: min 8 chars (32 recommended), no max; mix upper, lower, digit and a
#   symbol (- _ . ~); no spaces, $, #, quotes or backslash.
DB_PASSWORD=changethis

# ── Token verification — RS256 via JWKS ──────────────────────────────────────
# Access-token algorithm: RS256 (default, asymmetric via JWKS) or HS256
# (shared ACCESS_SECRET_KEY).
ACCESS_TOKEN_ALGORITHM=RS256
# Issuer JWKS URL the consumer fetches RS256 public keys from.
JWKS_URI=http://auth_user_service:8000/user/.well-known/jwks.json
# Seconds the consumer caches the issuer's JWKS document (default 300).
JWKS_CACHE_TTL_SECONDS=300
# HS256 refresh-token key (refresh tokens are always HS256); required even on
# consumers.
# Value: min 32 chars, no max; mix upper, lower, digit and a symbol (- _ . ~);
#   no spaces, $, #, quotes or backslash.
REFRESH_SECRET_KEY=changethis
# Must be HS256 (SDK-enforced).
REFRESH_TOKEN_ALGORITHM=HS256
# stateless (pure JWT) | hybrid (refresh JTIs in Redis) | stateful (Redis
# blacklist + DB sessions); must match the issuer.
TOKEN_MODE=hybrid
# Access-token lifetime in minutes (SDK default 30); keep it short and equal
# across issuer and consumers.
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Refresh-token lifetime in minutes (SDK default 120).
REFRESH_TOKEN_EXPIRE_MINUTES=1440

# ── Token boundary claims — REQUIRED under secure-by-default ──────────────────
# auth-sdk-m8 >= 1.0.0 turns TOKEN_STRICT_VALIDATION on by default: this consumer
# fails closed at boot unless both are set, and rejects tokens whose iss/aud claim
# differs. Must match auth_user_service TOKEN_ISSUER / TOKEN_AUDIENCE exactly.
# Opt out (legacy/local only) with TOKEN_STRICT_VALIDATION=false.
TOKEN_ISSUER=https://auth.example.com
TOKEN_AUDIENCE=https://api.example.com

# ── Token revocation ───────────────────────────────────────────────────────────
# hybrid mode: access tokens are stateless (no revocation); not required.
# Switch TOKEN_MODE=stateful to enable full revocation via HTTP introspection.
# Per-consumer auth (the legacy bare shared-secret gate is retired): present
# X-Internal-Client=INTERNAL_CLIENT_ID + X-Internal-Token=PRIVATE_API_SECRET,
# matching an auth-service PRIVATE_API_CONSUMERS entry.
# INTROSPECTION_URL=http://auth_user_service:8000/user/private/v1/jti-status
INTERNAL_CLIENT_ID=example-api
# Consumer bootstrap secret — must match the entry for this consumer id in
# auth.env PRIVATE_API_CONSUMERS. Required when INTERNAL_CLIENT_ID is set.
# Value: min 32 chars, no max; mix upper, lower, digit and a symbol (- _ . ~);
#   no spaces, $, #, quotes or backslash.
PRIVATE_API_SECRET=changethis

# ── API-key remote introspection (§3.12) ──────────────────────────────────────
# Enables the remote API-key principal dependencies (get_current_api_key_principal /
# require_api_key_role) so a key resolves its owner's *live* role via the issuer's
# POST /private/v1/api-keys/introspect — never a bare/cached key check. Fails
# closed at startup if incomplete. Independent of TOKEN_MODE/INTROSPECTION_URL
# above (that pair is JTI-revocation only) — this stack leaves INTROSPECTION_URL
# commented out (hybrid mode), so the endpoint is set explicitly here. Requires
# this consumer to hold the api-key-introspection scope in auth.env
# PRIVATE_API_CONSUMERS.
API_KEY_INTROSPECTION_ENABLED=true
API_KEY_INTROSPECTION_URL=http://auth_user_service:8000/user/private/v1/api-keys/introspect

# ── Event signing — auth-sdk-m8 1.0.0 boot validator (fail-closed when enabled) ──
# DEV ONLY — replace with a secrets-managed value; boot fails closed without it
# Must match EVENT_SIGNING_KEY in auth.env.example for this stack.
EVENT_SIGNING_ENABLED=true
# Value: min 32 chars, no max; mix upper, lower, digit and a symbol (- _ . ~);
#   no spaces, $, #, quotes or backslash.
EVENT_SIGNING_KEY=changethis

# ── Observability ─────────────────────────────────────────────────────────────
# Expose Prometheus /metrics (default false).
METRICS_ENABLED=false
# Comma list of metric groups: all | traffic, performance, reliability,
# health, auth.
METRICS_GROUPS=all

# ── Response security headers (auth-sdk-m8 >= 1.2.1, three tiers) ────────────────
# Applied by fastapi-m8 create_app. Tier 1 (X-Content-Type-Options, X-Frame-Options)
# is always on; tier 2 (Referrer-Policy, Permissions-Policy) applies on the production
# gate. Tier 3 below is browser-persisted and hard to reverse (HSTS poisons a host's
# HTTPS cache for its full max-age), so it is express opt-in, defaults to off, and is
# NEVER emitted on a local stack even if enabled. Enable only on a TLS-terminated host.
#HSTS_ENABLED=false
#CONTENT_SECURITY_POLICY_ENABLED=false
#HSTS_MAX_AGE=31536000
#HSTS_INCLUDE_SUBDOMAINS=true
#CONTENT_SECURITY_POLICY=
