# auth.env.prod_example — Example auth.env for production with an external Vault.
#
# Key differences from auth.env.example:
#
#   ENVIRONMENT=production  — activates VaultProvider in auth-sdk-m8.
#   DB_PASSWORD absent      — provided by Vault at startup. Never put it here.
#   REDIS_PASSWORD absent   — provided by Vault at startup. Never put it here.
#   SET_DOCS/SET_REDOC=false — hide API schema in production.
#
# SECRET_PROVIDER, VAULT_ADDR, and VAULT_TOKEN are NOT in this file.
# pydantic extra="forbid" rejects unknown dotenv keys, so Vault config
# must be passed as OS environment variables in docker-compose.yml (or your
# deployment tool). See the compose snippet in README.md → "Using with an
# external Vault".
#
# Variables marked <inject-via-cicd> should never be committed to version
# control. Store them in your CI/CD secrets store and inject at deploy time.
# They can also be moved to Vault — see "Extending Vault coverage" in the README.

# ── Identity ──────────────────────────────────────────────────────────────────
DOMAIN=yourdomain.com
ENVIRONMENT=production
PROJECT_NAME=MyAuthService
STACK_NAME=my-auth-service

# ── API & docs ────────────────────────────────────────────────────────────────
API_PREFIX=/user
SET_OPEN_API=false
SET_DOCS=false
SET_REDOC=false

# ── CORS / Frontend ───────────────────────────────────────────────────────────
BACKEND_HOST=https://api.yourdomain.com
FRONTEND_HOST=https://app.yourdomain.com
BACKEND_CORS_ORIGINS=https://app.yourdomain.com,https://api.yourdomain.com

# ── Service role ──────────────────────────────────────────────────────────────
AUTH_SERVICE_ROLE=issuer

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# DB_PASSWORD is intentionally absent — provided by Vault (secret/data/app → DB_PASSWORD).
# DB_USER must match AUTH_DB_USER in .env (or the user pre-provisioned in your managed DB).
SELECTED_DB=Postgres
DB_HOST=m8_db               # replace with managed DB hostname for external DB
DB_PORT=5432
DB_DATABASE=auth_db
DB_USER=auth_user

# ── Redis ─────────────────────────────────────────────────────────────────────
# REDIS_PASSWORD is intentionally absent — provided by Vault (secret/data/app → REDIS_PASSWORD).
REDIS_HOST=redis_cache      # replace with managed Redis hostname for external Redis
REDIS_PORT=6379
REDIS_USER=auth

# ── RS256 asymmetric signing ──────────────────────────────────────────────────
ACCESS_TOKEN_ALGORITHM=RS256
REFRESH_TOKEN_ALGORITHM=HS256
ACCESS_PRIVATE_KEY_FILE=/opt/keys/private.pem
ACCESS_PUBLIC_KEY_FILE=/opt/keys/public.pem
ACCESS_KEY_ID=<generated-by-init.sh>
REFRESH_SECRET_KEY=<inject-via-cicd>
TOKEN_MODE=stateful
ACCESS_TOKEN_EXPIRE_MINUTES=15      # keep short in production
REFRESH_TOKEN_EXPIRE_MINUTES=1440

# ── Token boundary claims — REQUIRED under secure-by-default ──────────────────
# auth-sdk-m8 >= 1.0.0 turns TOKEN_STRICT_VALIDATION on by default: the service
# fails closed at boot unless both are set, and every validator requires an exact
# iss/aud match. Use identical values in this auth service and every consumer.
# Opt out (legacy/local only) with TOKEN_STRICT_VALIDATION=false.
TOKEN_ISSUER=https://auth.yourdomain.com
TOKEN_AUDIENCE=https://api.yourdomain.com

# ── Auth-service-only secrets ─────────────────────────────────────────────────
# These can also be stored in Vault if you extend the vault-init pipeline.
# See "Extending Vault coverage" in README.md.
FIRST_SUPERUSER=admin@yourdomain.com
FIRST_SUPERUSER_PASSWORD=<inject-via-cicd>
PRIVATE_API_SECRET=<inject-via-cicd>
# Per-consumer private-API credentials (v1.0.0 — REQUIRED; legacy single-secret
# gate retired). Inject the JSON map (hashed `sha256$` secrets) via CI/CD or a
# PRIVATE_API_CONSUMERS_FILE Vault mount; empty → every /private/* call 401s.
#PRIVATE_API_CONSUMERS=<inject-via-cicd>
SESSION_SECRET=<inject-via-cicd>
TOKENS_ENCRYPTION_KEY=<inject-via-cicd>
# Set only during a TOKENS_ENCRYPTION_KEY rotation: the previous key, kept so
# external OAuth tokens encrypted under it stay decryptable (MultiFernet new→old).
# Remove once every stored token has been re-encrypted under / expired past the
# new key. Inject via CI/CD only while a rotation is in flight.
#TOKENS_ENCRYPTION_KEY_OLD=<inject-via-cicd>

# ── Event signing — auth-sdk-m8 1.0.0 boot validator (fail-closed when enabled) ──
# Store in Vault at secret/data/app and inject via your secrets pipeline.
EVENT_SIGNING_ENABLED=true
EVENT_SIGNING_KEY=<inject-via-cicd>

# ── Observability ─────────────────────────────────────────────────────────────
METRICS_ENABLED=true
METRICS_GROUPS=all

# ── Response security headers (auth-sdk-m8 >= 1.2.1, three tiers) ────────────────
# Tier 1 (X-Content-Type-Options, X-Frame-Options) is always on; tier 2
# (Referrer-Policy, Permissions-Policy) applies on the production gate. Tier 3 below
# is browser-persisted and hard to reverse (HSTS poisons a host's HTTPS cache for
# its full max-age), so it is express opt-in, defaults to off, and is NEVER emitted
# on a local stack even if enabled. Enable only on a TLS-terminated public host.
#HSTS_ENABLED=false
#CONTENT_SECURITY_POLICY_ENABLED=false
#HSTS_MAX_AGE=31536000
#HSTS_INCLUDE_SUBDOMAINS=true
#CONTENT_SECURITY_POLICY=

# ── Retention and revocation propagation (v2.0.0) ─────────────────────────────
# All optional; the defaults are the production posture. Documented in full in
# `auth_user_service/.example_env`. Listed here because each is an operator
# decision a production deployment may legitimately need to tune.
#
# Transactional outbox that drains role-change revocation side effects. The DB
# revocation is already authoritative, so a lagging worker only slows consumer
# cache eviction — it never changes correctness.
#OUTBOX_WORKER_ENABLED=true
#OUTBOX_DRAIN_INTERVAL_SECONDS=1.0
#OUTBOX_BATCH_SIZE=50
#OUTBOX_LEASE_SECONDS=30
#OUTBOX_MAX_ATTEMPTS=5
#OUTBOX_BACKOFF_BASE_SECONDS=2.0
#OUTBOX_BACKOFF_CAP_SECONDS=300.0
# Retention (seconds) for completed outbox rows before reaping (0 = keep forever).
#OUTBOX_COMPLETED_RETENTION_SECONDS=3600
#
# Deletion tombstones keep denying every token ever minted for a deleted user.
# The issuer derives most of the retention horizon itself (access-token TTL,
# refresh-session lifetime, completed-outbox retention) and never cleans up a
# tombstone whose subject is still named by an undelivered (pending/leased/
# dead-letter) outbox effect. This setting declares the part the issuer cannot
# observe: how long a *consumer* may still hold a positive cache entry for the
# subject or replay a session-revoked event about it. Set it to the longest
# revocation-cache TTL / event-replay window across your consumers. A floor,
# never a ceiling — the effective retention is the maximum of all four values.
#TOMBSTONE_CONSUMER_HORIZON_SECONDS=3600
#
# Retention floors for the two superadmin-gated purges. Both default to 90 days
# and CANNOT be lowered per request — lowering either is an explicit operator
# configuration decision, never a per-call parameter.
#AUDIT_PURGE_MIN_RETENTION_SECONDS=7776000
#AUDIT_PURGE_BATCH_SIZE=500
#API_KEY_PURGE_MIN_RETENTION_SECONDS=7776000
#API_KEY_PURGE_BATCH_SIZE=500
#
# Maximum number of audiences (remote-service consumers) one API key may bind.
#API_KEY_MAX_AUDIENCES=3
