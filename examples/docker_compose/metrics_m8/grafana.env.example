# Grafana admin password.
# Value: not validated by the services; use 16+ chars (32 recommended), no
#   max; letters, digits and - _ . ~ only.
GF_SECURITY_ADMIN_PASSWORD=changethis
# Grafana: allow self-service sign-up (keep false).
GF_USERS_ALLOW_SIGN_UP=false
# Grafana: comma-separated plugins fetched at start; empty = none (smaller
# supply-chain surface).
GF_INSTALL_PLUGINS=grafana-piechart-panel
