# Copy to api.env.production — fastapi_full consumer PRODUCTION configuration.
#
# Mounted by the production overlay (docker-compose.production.yml) in place of
# the dev api.env. Token verification uses JWKS — no private key needed.
# Every secret is the literal `changethis` so the stack FAILS CLOSED until filled.

# ── Identity ──────────────────────────────────────────────────────────────────
# Hostname this stack is served on (localhost, an IPv4 or a domain).
DOMAIN=api.example.com
# local | development | staging | production - selects the SDK's security
# posture.
ENVIRONMENT=production
# Turn production-risk warnings into startup failures (default false).
STRICT_PRODUCTION_MODE=true
# Project identifier shown in API docs and logs (letters, digits, _ and -).
PROJECT_NAME=M8FastApi
# Stack slug used in names and logs (lowercase letters, digits and -).
STACK_NAME=m8-fastapi-service

# ── API & docs (off in production) ────────────────────────────────────────────
# Route prefix the service is mounted under behind Traefik (path chars only,
# e.g. /user).
API_PREFIX=/fastapi
# Serve the OpenAPI schema (true | false).
SET_OPEN_API=false
# Serve Swagger UI (true | false).
SET_DOCS=false
# Serve ReDoc (true | false).
SET_REDOC=false

# ── Host allowlist (fatal under strict if empty) ──────────────────────────────
# Comma-separated Host header allowlist (e.g. example.com,www.example.com);
# required in production.
ALLOWED_HOSTS=api.example.com

# ── CORS / Frontend (no localhost origins in production) ───────────────────────
# Public base URL of this backend (scheme://host[:port]).
BACKEND_HOST=https://api.example.com
# Public URL of the frontend (scheme://host[:port]); used in links the backend
# emits.
FRONTEND_HOST=https://app.example.com
# Comma-separated browser origins allowed by CORS, each scheme://host[:port]
# with no path.
BACKEND_CORS_ORIGINS=https://app.example.com

# ── Session cookie ─────────────────────────────────────────────────────────────
# Secure flag on the session cookie (default true; false only for plain-http
# local dev).
SESSION_COOKIE_SECURE=true

# ── Service role & auth routing ───────────────────────────────────────────────
# issuer (mints tokens, holds keys) or consumer (only validates tokens; must
# not hold private keys).
AUTH_SERVICE_ROLE=consumer
# Sub-prefix of the auth routes a fastapi-m8 consumer mounts (default /auth).
AUTH_PREFIX=/user

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Database dialect: Postgres | Mysql | Mariadb.
SELECTED_DB=Postgres
# Database hostname (compose service name, or a managed DB host).
DB_HOST=m8_db
# Database port (1-65535; 5432 for PostgreSQL).
DB_PORT=5432
# Database name the service connects to (letters, digits, _ and -).
DB_DATABASE=api_db
# Database role the service logs in as (created by init-db.sh).
# Value: PostgreSQL role name - letters, digits and _, starting with a letter;
#   max 63 chars.
DB_USER=changethis_api_user
# Password of DB_USER.
# Value: min 8 chars (32 recommended), no max; mix upper, lower, digit and a
#   symbol (- _ . ~); no spaces, $, #, quotes or backslash.
DB_PASSWORD=changethis

# ── Token verification — RS256 via JWKS ──────────────────────────────────────
# Access-token algorithm: RS256 (default, asymmetric via JWKS) or HS256
# (shared ACCESS_SECRET_KEY).
ACCESS_TOKEN_ALGORITHM=RS256
# Issuer JWKS URL the consumer fetches RS256 public keys from.
JWKS_URI=http://auth_user_service:8000/user/.well-known/jwks.json
# Seconds the consumer caches the issuer's JWKS document (default 300).
JWKS_CACHE_TTL_SECONDS=300
# HS256 refresh-token key (refresh tokens are always HS256); required even on
# consumers.
# Value: min 32 chars, no max; mix upper, lower, digit and a symbol (- _ . ~);
#   no spaces, $, #, quotes or backslash.
REFRESH_SECRET_KEY=changethis
# Must be HS256 (SDK-enforced).
REFRESH_TOKEN_ALGORITHM=HS256
# stateless (pure JWT) | hybrid (refresh JTIs in Redis) | stateful (Redis
# blacklist + DB sessions); must match the issuer.
TOKEN_MODE=stateful
# Access-token lifetime in minutes (SDK default 30); keep it short and equal
# across issuer and consumers.
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Refresh-token lifetime in minutes (SDK default 120).
REFRESH_TOKEN_EXPIRE_MINUTES=1440

# ── Internal service-to-service HTTP (single trusted Docker host) ──────────────
# JWKS_URI / INTROSPECTION_URL reach auth_user_service over the Docker network on
# http://. Under strict production this is FATAL unless explicitly allowed. On a
# single trusted Docker host this is acceptable; multi-host deployments should use
# TLS/mTLS between services instead (see plan items 1.3 / 9.2).
ALLOW_INTERNAL_HTTP=true

# ── Token boundary claims — must match the issuer exactly (fatal under strict) ──
TOKEN_STRICT_VALIDATION=true
TOKEN_ISSUER=https://auth.example.com
TOKEN_AUDIENCE=https://api.example.com

# ── Token revocation (stateful mode) ──────────────────────────────────────────
# Per-consumer bootstrap credential (v1.0.0): present X-Internal-Client=
# INTERNAL_CLIENT_ID + X-Internal-Token=PRIVATE_API_SECRET, matching an
# auth-service PRIVATE_API_CONSUMERS entry (legacy bare shared-secret gate retired).
INTROSPECTION_URL=http://auth_user_service:8000/user/private/v1/jti-status
INTERNAL_CLIENT_ID=media-service
# Value: min 32 chars, no max; mix upper, lower, digit and a symbol (- _ . ~);
#   no spaces, $, #, quotes or backslash.
PRIVATE_API_SECRET=changethis

# ── API-key remote introspection (§3.12) ──────────────────────────────────────
# Enables the remote API-key principal dependencies (get_current_api_key_principal /
# require_api_key_role) so a key resolves its owner's *live* role via the issuer's
# POST /private/v1/api-keys/introspect — never a bare/cached key check. Fails
# closed at startup if incomplete. URL derives from INTROSPECTION_URL above
# (…/jti-status → …/api-keys/introspect); set API_KEY_INTROSPECTION_URL to
# override. Requires this consumer to hold the api-key-introspection scope in
# auth.env PRIVATE_API_CONSUMERS.
API_KEY_INTROSPECTION_ENABLED=true

# ── Auth degradation policy (fail closed) ─────────────────────────────────────
# true forces every Redis-dependent security control to fail_closed (503) when
# Redis is down.
AUTH_STRICT_MODE=true
# When the revocation check cannot reach Redis/the issuer: fail_closed
# (reject, default) or fail_open (allow, logged).
ACCESS_REVOCATION_FAILURE_MODE=fail_closed
#REFRESH_VALIDATION_FAILURE_MODE=fail_closed
#SESSION_WRITE_FAILURE_MODE=fail_closed
#RATE_LIMIT_FAILURE_MODE=fail_open

# ── Event signing — must match auth.env.production ────────────────────────────
# Sign/verify auth events with EVENT_SIGNING_KEY (default true; boot fails
# without the key).
EVENT_SIGNING_ENABLED=true
# HMAC key for auth event signing; identical in the issuer and every consumer.
# Value: min 32 chars, no max; mix upper, lower, digit and a symbol (- _ . ~);
#   no spaces, $, #, quotes or backslash.
EVENT_SIGNING_KEY=changethis

# ── Auth event stream (best-effort cache eviction) ────────────────────────────
# Seconds a positive introspection result is cached (>= 0; 0 = no cache,
# default).
REVOCATION_CACHE_TTL_SECONDS=30

# ── Observability ─────────────────────────────────────────────────────────────
# Expose Prometheus /metrics (default false).
METRICS_ENABLED=true
# Comma list of metric groups: all | traffic, performance, reliability,
# health, auth.
METRICS_GROUPS=all

# ── Response security headers (opt-in HSTS even in production) ─────────────────
#HSTS_ENABLED=false
#CONTENT_SECURITY_POLICY_ENABLED=false
#HSTS_MAX_AGE=31536000
#HSTS_INCLUDE_SUBDOMAINS=true
#CONTENT_SECURITY_POLICY=
