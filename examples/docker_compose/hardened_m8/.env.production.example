# Copy to .env — Docker Compose infrastructure variables (PRODUCTION).
#
# Compose auto-loads `.env`, so the production overlay reads this file once it is
# copied to `.env`. Application settings live in auth.env.production /
# api.env.production. Generate passwords:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# ── Traefik port binding ─────────────────────────────────────────────────────
# NOTE: the production overlay publishes only :80 (HTTP→HTTPS redirect) and :443,
# and does NOT host-publish the internal :9000 entryPoint or the DB/Redis/
# Prometheus/Grafana ports. API_BIND_IP is therefore unused under the overlay —
# kept here only for the dev base. It must NEVER be 0.0.0.0 in production
# (preflight blocks API_BIND_IP=0.0.0.0 when ENVIRONMENT=production).
#API_BIND_IP=127.0.0.1

# ── PostgreSQL superuser (engine bootstrap) ───────────────────────────────────
# Used by the postgres container + init-db.sh to create per-service users.
DB_USER=m8_admin
DB_PASSWORD=changethis
DB_PORT=5432

# ── Per-service DB isolation (separate DB + user per service) ─────────────────
AUTH_DB_USER=changethis_auth_user
AUTH_DB_PASSWORD=changethis
AUTH_DB_NAME=auth_db

API_DB_USER=changethis_api_user
API_DB_PASSWORD=changethis
API_DB_NAME=api_db

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=changethis
